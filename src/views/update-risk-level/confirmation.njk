{% extends 'common/layout.njk' %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: heading
      }) }}

      <ul class="govuk-list">
        {% for link in links %}
          <li><a class="govuk-link" href="{{ link.href }}">{{ link.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endblock %}
