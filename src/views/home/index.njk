{% extends 'common/layout.njk' %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body" data-testid="app-page-body">{{ intro }}</p>

      <ul class="govuk-list">
        {% for link in links %}
          <li><a class="govuk-link" href="{{ link.href }}">{{ link.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

{% endblock %}
